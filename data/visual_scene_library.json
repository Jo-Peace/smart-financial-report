{
  "version": 1,
  "description": "/2 每日自動視覺主題的本機場景庫（不呼叫任何 LLM）。只放日常、非 IP、非體育賽事的場景；regen_assets 依本機事實分類 archetype，排除近 5 個交易日用過、packaging_bans 禁用與近 5 個交易日 channel log 主題「禁止…」清單點名的場景，再以日期為種子決定性挑選。",
  "theme_format": "{label}漫畫（漲紅跌綠）：{metaphor}；{cast}（不含 A/B 封面字指示：封面字由本週 A/B 假設決定）",
  "max_chars": 150,
  "slots": {
    "{hero}": "封面主角股名（與封面事實對帳同一檔）",
    "{amount}": "主角外資金額（與封面同一字串，例如 55.3億）",
    "{pct}": "主角漲跌詞＋幅度（噴9.4%／跌3.1%／鎖漲停／守平盤）；對照股留空",
    "{other}": "對照股名（反方向榜首）；組句時以 {hero} 位置帶入",
    "{flow_color}": "紅色（買超）或綠色（賣超）：顏色標的是外資買賣方向；股價漲跌用 {pct} 的文字表達",
    "{flow_word}": "買超或賣超",
    "[...]": "可省略片段：裡面的欄位是空的就整段省略（例如對照股沒有漲跌時省略「水位尺{pct}」）"
  },
  "archetypes": {
    "大跌守線": "大盤跌幅 ≥ 1.5%：主角守住或逆勢",
    "大盤強彈": "大盤漲幅 ≥ 1.5%：主角跟著升溫",
    "量價背離": "主角外資方向與股價方向相反（買超卻收跌、賣超卻收漲，或百億級進出卻平盤）",
    "換手": "權值股大額賣超（≥ 80 億）、另一檔被大買（≥ 20 億）",
    "權值提款": "權值股賣超 ≥ 150 億，買方力道弱或大盤收跌",
    "漲停鎖量": "主角漲停，或買超榜 ≥ 2 檔漲停",
    "單股暴衝": "主角外資買超且漲幅 ≥ 5%",
    "土洋對作": "主角外資與投信方向相反且投信金額 ≥ 5 億",
    "盤整觀望": "以上皆不成立（大盤小漲小跌）"
  },
