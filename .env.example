# Copy to .env and fill in. Never commit .env.
# Full flag reference: docs/env_flags.md. At start-up /1 prints every
# non-default / risky flag that is active (modules/runtime_flags.py).

# --- API keys (required for /1) ---
GEMINI_API_KEY=
TAVILY_API_KEY=
# Optional: YouTube view-count updates
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCRWXWHHOs4iSDac1GHLsExw
# Optional: FinMind fallback for TWSE data (FINMIND_API_TOKEN is a legacy alias)
FINMIND_TOKEN=
FINMIND_FALLBACK=0
FINMIND_TIMEOUT_SEC=30

# --- Gemini ---
# Concrete model ID (avoid floating "-latest" aliases)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_CALL_LIMIT=8
GEMINI_HTTP_TIMEOUT_MS=180000
GEMINI_RESUME_MODEL=gemini-2.5-flash
# GEMINI_USAGE_LOG_PATH=data/gemini_usage_log.jsonl
# Backup models after a 503 / timeout / quota / retired-model error (none = disable; banner warns)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# GEMINI_FALLBACK_AFTER_ATTEMPTS=
# Daily budget: calls reserved for /1 report + structured + /2 package; weight of a failed call
# GEMINI_RESERVED_CALLS=3
# GEMINI_ERROR_CALL_WEIGHT=0.25
# GEMINI_LIGHT_THINKING_LEVEL=
# GEMINI_LIGHT_THINKING_BUDGET=
# YOUTUBE_PACKAGE_MAX_ATTEMPTS=3
# Video length (seconds or mm:ss) for YouTube chapter timestamps
# YOUTUBE_VIDEO_DURATION=

# --- Report safety checks (leave at defaults; /1 warns when relaxed) ---
# annotate | warn | off   (off publishes wrong ranks / amounts unchecked)
REPORT_FACT_CHECK=annotate
# 1 = rebuild the 法人 / 成交值 tables from local data; 0 publishes Gemini's copy
REPORT_LOCAL_TABLES=1
# strict | warn | off   (missing core sections: retry / print only / skip)
REPORT_SECTION_CHECK=strict

# --- /1 behaviour (defaults shown; leave unset unless you mean it) ---
# strict | warn | off   (off silently skips the data quality gate)
DATA_QUALITY_GATE=strict
ALLOW_DATA_QUALITY_FAIL=
# Run /1 before 16:10 (FORCE_RUN_BEFORE_1610 is a legacy alias)
ALLOW_EARLY_RUN=
# Back-fill (ALLOW_HOLIDAY_RUN is a legacy alias): 1 = on a holiday/weekend use the
# latest session and relabel to it; YYYY-MM-DD = back-fill exactly that session
# (also on a trading day). Overwrites that day's artifacts; remove after use.
ALLOW_STALE_SESSION=
NEWS_MODE=smart
TAVILY_DAILY_SEARCH_LIMIT=20
VALIDATION_MAX_TRADING_GAP=1
KNOWLEDGE_WIKI_MODE=local
NOTEBOOKLM_PROMPT_MODE=local
NOTEBOOKLM_SKILL_HINTS=
SKIP_MONTHLY_CONSOLIDATE=
PROJECT_THEME=
# Visual theme is set by /2 (THUMBNAIL_STYLE is a legacy alias)
DAILY_VISUAL_THEME=
ALLOW_SPORTS_ANIME_THEME=

# --- run_daily.sh / automation ---
# PYTHON_BIN=/usr/local/bin/python3
# RUN_DAILY_LOCK_DIR=/tmp/stock-youtube-run-daily.lock
# RUN_DAILY_NOTIFY=1

# --- Web app (app/main_app.py, Render) ---
# STOCK_RESEARCH_DB_PATH=/var/data/stock_research.db
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=
# 1 = log the raw X-Forwarded-For / client-IP headers once (verify TRUSTED_PROXY_HOPS after a deploy)
# LOG_CLIENT_IP_HEADERS=0
# WEB_GEMINI_MAX_RETRIES=1
# WEB_GEMINI_FALLBACK_AFTER_ATTEMPTS=1
# WEB_TAVILY_SEARCHES_PER_REPORT=2
# Set automatically by Render; shown as info.commit in /healthz
# RENDER_GIT_COMMIT=
